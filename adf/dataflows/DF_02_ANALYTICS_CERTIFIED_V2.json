            "type": "LinkedServiceReference"
          },
          "name": "StationFile"
        },
        {
          "linkedService": {
            "referenceName": "LS_ADLS",
            "type": "LinkedServiceReference"
          },
          "name": "WeatherQualityFile"
        },
        {
          "linkedService": {
            "referenceName": "LS_ADLS",
            "type": "LinkedServiceReference"
          },
          "name": "WeatherFile"
        },
        {
          "linkedService": {
            "referenceName": "LS_ADLS",
            "type": "LinkedServiceReference"
          },
          "name": "VelibQualityFile"
        },
        {
          "linkedService": {
            "referenceName": "LS_ADLS",
            "type": "LinkedServiceReference"
          },
          "name": "VelibFile"
        },
        {
          "linkedService": {
            "referenceName": "LS_ADLS",
            "type": "LinkedServiceReference"
          },
          "name": "VelibGoldFile"
        },
        {
          "linkedService": {
            "referenceName": "LS_ADLS",
            "type": "LinkedServiceReference"
          },
          "name": "RawQualityFile"
        },
        {
          "linkedService": {
            "referenceName": "LS_ADLS",
            "type": "LinkedServiceReference"
          },
          "name": "ExactQualityFile"
        },
        {
          "linkedService": {
            "referenceName": "LS_ADLS",
            "type": "LinkedServiceReference"
          },
          "name": "AbonnesQualityFile"
        }
      ],
      "sources": [
        {
          "linkedService": {
            "referenceName": "LS_ADLS",
            "type": "LinkedServiceReference"
          },
          "name": "Silver"
        },
        {
